# Producción (Hostinger / LiteSpeed). El servidor local php -S ignora este archivo.

Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Siempre HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Dominio canónico sin www (coincide con SITE_CANONICAL)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# /index.php duplica la portada: se redirige a / conservando ?lang=
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.php[\s?]
RewriteRule ^index\.php$ / [L,R=301]

# Direcciones de la web antigua (WordPress) que Google sigue visitando
RewriteRule ^services/?$ /servicios.php [L,R=301]
RewriteRule ^faqs/?$ /dudas.php [L,R=301]
RewriteRule ^(quienes-somos|servicios|dudas|contacto|reserva-de-citas|aviso-legal|politica-de-privacidad|politica-de-cookies)/$ /$1.php [L,R=301]
RewriteRule ^public(/.*)?$ / [L,R=301]

# Restos de WordPress que ya no existen: 410 para que Google deje de pedirlos
RewriteRule ^(wp-content|wp-admin|wp-includes|wp-json|feed|comments|cart|checkout|my-account|shop)(/|$) - [G,L]
RewriteRule ^(wp-login|xmlrpc)\.php$ - [G,L]
RewriteCond %{QUERY_STRING} (^|&)(s|wc-ajax)= [NC]
RewriteRule ^$ - [G,L]

# Archivos ocultos (.git, .env…) nunca accesibles; se permite .well-known para certificados
RewriteRule (^|/)\.(?!well-known/) - [F]

# Caché larga para recursos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
